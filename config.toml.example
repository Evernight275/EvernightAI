# EvernightAI configuration example.
# Copy this file to config.toml and adjust values for your environment.

[runtime]
# SQLite runtime database path.
database_path = ".evernight/runtime.sqlite3"
# Sandbox backend for process tools: "subprocess" or "bubblewrap".
# "subprocess" preserves broad compatibility. "bubblewrap" uses Linux
# namespaces and bind mounts for stronger local isolation when bwrap is
# installed and permitted by the host.
sandbox_backend = "subprocess"

[context_strategy]
# Optional model-visible window controls. Basic composition is always first.
# Summary requires an application-provided summarizer; leave disabled unless
# your runtime assembly injects one.
# max_messages = 80
# max_tokens = 12000
enable_summary = false
summarize_after_messages = 100
keep_recent_messages = 20

[http]
# Used by both `evernight-http` and `evernight serve`.
# 注意:
# 服务器上部署时，不要在安全组直接放行该端口，也不要轻易把 host 改成 0.0.0.0
# 因配置不当导致的安全风险、数据泄露或财产损失，项目维护者不承担责任。
host = "127.0.0.1"
port = 8000
reload = false
server_header = "EvernightAI"
# Serve the compiled frontend from the same HTTP process after `pnpm run build`.
static_files_path = "frontend/dist"

[auth]
# Disabled by default for local development. When enabled, HTTP requests use
# Authorization/X-Evernight-API-Key. CLI commands use the single configured
# principal, or EVERNIGHTAI_CLI_API_KEY when multiple principals are present.
enabled = false

[auth.principal.admin]
# Requests may use either `Authorization: Bearer ...` or `X-Evernight-API-Key`.
api_key_env = "EVERNIGHTAI_HTTP_API_KEY"
permissions = ["*"]

[auth.oauth.jwt]
# OAuth access tokens use `Authorization: Bearer ...`.
# Configure these values from your identity provider's OIDC metadata.
issuer = "https://idp.example.com/realms/evernight"
audience = ["evernight-admin-api"]
jwks_url = "https://idp.example.com/realms/evernight/protocol/openid-connect/certs"
algorithms = ["RS256"]
# Map IdP roles/scopes to EvernightAI permissions. Use ["*"] only for admins.
roles_claim = "realm_access.roles"
role_permission_map = { evernight_admin = ["*"], evernight_reader = ["tools:list", "providers:list_models"] }

[tools.filesystem]
# Keep disabled unless you intentionally want file tools exposed.
enabled = false
root = "."
max_read_chars = 12000
max_directory_entries = 100
max_search_results = 100
allow_write = false

[tools.shell]
# Keep disabled unless you intentionally want shell tools exposed.
enabled = false
# A single executable allows its arguments; a multi-part entry matches exactly.
allowed_commands = ["python --version", "uv"]
# Blocked rules win over allowed commands and are rejected before approval or
# execution. A single executable blocks every argument; a multi-part entry
# blocks that command prefix and its arguments.
blocked_commands = ["uv publish", "git reset --hard", "rm"]
working_directory = "."
timeout_seconds = 10.0
max_output_chars = 12000
is_need_approval = true
# Set to a list to restrict per-call env overrides; leave unset to allow any
# env key when the shell tool is enabled.
# allowed_env_keys = ["PYTHONPATH"]

[tools.web]
# Keep disabled unless you intentionally want network tools exposed.
enabled = false
# Leave unset to allow any host, or set a strict allowlist.
# allowed_hosts = ["example.com"]
download_directory = ".evernight/downloads"
timeout_seconds = 10.0
max_response_chars = 12000
max_download_bytes = 10000000

[tools.git]
# Keep disabled unless you intentionally want git tools exposed.
enabled = false
repository_directory = "."
timeout_seconds = 10.0
max_output_chars = 12000

[tools.project]
# Keep disabled unless you intentionally want project task tools exposed.
enabled = false
working_directory = "."
timeout_seconds = 120.0
max_output_chars = 20000
commands = { tests = [".venv/bin/python", "-m", "pytest"], typecheck = [".venv/bin/pyright"], format = ["python", "-m", "compileall", "src"], dependency_scan = ["python", "-m", "pip", "check"] }

# Optional per-project task overrides. Missing project tasks fall back to the
# global commands above. Project directories must be declared here; the tool
# call uses the project name and can never supply an arbitrary working path.
# Filesystem tools also accept these names through `project`; writes keep their
# normal approval requirements and remain confined to the selected root.
# project_directories = { EvernightAI = "/home/cyrene/EvernightAI" }
# [tools.project.projects.EvernightAI]
# tests = ["uv", "run", "pytest"]

[tools.runtime_data]
# Enables tools that can write contexts and memories through the runtime.
enabled = false

# Remote MCP tools use Streamable HTTP. Tools are discovered during runtime
# initialization and registered as `<namespace>__<remote_tool_name>`. Security
# remains local: remote tools always receive network/external_api permissions.
[tools.mcp.server.example]
enabled = false
transport = "streamable_http"
url = "https://mcp.example.com/mcp"
namespace = "example"
# The token value is read from the environment and is never copied into tool
# definitions, HTTP responses, or config output.
token_env = "EXAMPLE_MCP_TOKEN"
# Leave allowed_tools unset to allow every discovered tool. Blocked tools win
# over discovery and are never registered.
# allowed_tools = ["search", "get_document"]
blocked_tools = ["delete_repository"]
max_tools = 100
max_definition_chars = 12000
timeout_seconds = 30.0
max_output_chars = 20000
is_need_approval = true
watch_tool_changes = true
# Polling is optional fallback for servers that do not advertise
# notifications/tools/list_changed.
# refresh_interval_seconds = 60.0
refresh_retry_seconds = 5.0

# Legacy SSE is explicit; EvernightAI never silently downgrades transports.
# [tools.mcp.server.legacy]
# enabled = true
# transport = "sse"
# url = "https://mcp.example.com/sse"
# namespace = "legacy"
# token_env = "LEGACY_MCP_TOKEN"
# sse_read_timeout_seconds = 300.0

# stdio executes one fixed, operator-declared process without a shell. Values
# in env_from map child variable names to host environment variable names.
# The process is trusted runtime infrastructure and is not confined by the
# restricted shell tool. Isolate untrusted servers at the OS/container layer.
# [tools.mcp.server.local]
# enabled = true
# transport = "stdio"
# command = "uvx"
# args = ["mcp-server-example"]
# cwd = "."
# env_from = { API_TOKEN = "LOCAL_MCP_API_TOKEN" }
# namespace = "local"

# SQLite data analysis sources expose read-only aggregate statistics over a
# table or view in the runtime database.
#
# [data_analysis.sqlite_source.orders]
# name = "Orders"
# table = "orders_view"
#
# [data_analysis.sqlite_source.orders.field.status]
# field_type = "string"
#
# [data_analysis.sqlite_source.orders.field.amount]
# field_type = "number"
#
# [data_analysis.sqlite_source.orders.metric.order_count]
# aggregation = "count"
#
# [data_analysis.sqlite_source.orders.metric.revenue]
# aggregation = "sum"
# field_id = "amount"

[provider.main]
name = "Main"
type = "openai"
is_enabled = true
# Keep model listing local by default. Set true only when you explicitly want
# EvernightAI to call the provider's models endpoint while listing models.
discover_models = false
api_key_env = "OPENAI_API_KEY"
# base_url can point to any OpenAI-compatible endpoint.
# base_url = "https://api.openai.com/v1"
# discover_models = true

[provider.main.model.chat]
model_id = "gpt-4.1-mini"
capabilities = ["chat", "tool_call", "image_recognition"]

# Additional provider examples:
#
# OpenAI exposes multiple API surfaces. Keep Responses models on an
# openai_responses provider; the upstream /models list does not identify which
# endpoint a model must use.
#
# [provider.openai_responses]
# name = "OpenAI Responses"
# type = "openai_responses"
# api_key_env = "OPENAI_API_KEY"
# base_url = "https://api.openai.com/v1"
#
# [provider.openai_responses.model.chat]
# model_id = "gpt-4.1-mini"
# capabilities = ["chat", "tool_call", "image_recognition"]
#
# [provider.deepseek]
# name = "DeepSeek"
# type = "openai"
# api_key_env = "DEEPSEEK_API_KEY"
# base_url = "https://api.deepseek.com/v1"
#
# [provider.deepseek.model.chat]
# model_id = "deepseek-chat"
# capabilities = ["chat"]
#
# [provider.gemini]
# name = "Gemini"
# type = "google"
# api_key_env = "GOOGLE_API_KEY"
#
# [provider.gemini.model.flash]
# model_id = "gemini-2.0-flash"
# capabilities = ["chat", "image_recognition"]
#
# [provider.anthropic]
# name = "Anthropic"
# type = "anthropic"
# api_key_env = "ANTHROPIC_API_KEY"
#
# [provider.anthropic.model.haiku]
# model_id = "claude-3-5-haiku-latest"
# capabilities = ["chat"]
